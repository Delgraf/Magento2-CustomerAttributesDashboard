{
    "name": "delgraf/module-customer-attributes-dashboard",
    "description": "Magento 2 module that displays Amasty Customer Attributes on the customer account dashboard, below the e-mail address.",
    "type": "magento2-module",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "keywords": [
        "magento",
        "magento2",
        "magento2-module",
        "amasty",
        "customer-attributes",
        "customer-account",
        "dashboard"
    ],
    "authors": [
        {
            "name": "Delgraf",
            "email": "info@delgraf.com",
            "homepage": "https://www.delgraf.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Delgraf/Magento2-CustomerAttributesDashboard/issues",
        "source": "https://github.com/Delgraf/Magento2-CustomerAttributesDashboard"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "^103.0",
        "magento/module-customer": "^103.0",
        "magento/module-eav": "^102.1",
        "magento/module-store": "^101.1",
        "amasty/module-customer-attributes": "^2.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Delgraf\\CustomerAttributesDashboard\\": ""
        }
    },
    "config": {
        "sort-packages": true
    }
}
