<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_dashboard_info">
            <!-- The alias matches getChildHtml('customer.account.dashboard.info.extra')
                 in Magento_Customer::account/dashboard/info.phtml, rendered right below the e-mail. -->
            <block class="Magento\Framework\View\Element\Template"
                   name="delgraf.customer.dashboard.attributes"
                   as="customer.account.dashboard.info.extra"
                   template="Delgraf_CustomerAttributesDashboard::account/dashboard/attributes.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Delgraf\CustomerAttributesDashboard\ViewModel\CustomerAttributes</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
