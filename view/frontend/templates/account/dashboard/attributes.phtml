<?php
/**
 * Custom customer attributes shown in the "Contact Information" box.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Delgraf\CustomerAttributesDashboard\ViewModel\CustomerAttributes $viewModel
 */
$viewModel = $block->getData('view_model');
if (!$viewModel || !$viewModel->hasRows()) {
    return;
}
$title = (string)$block->getData('title');
?>
<div class="delgraf-customer-attributes">
    <?php if ($title !== ''): ?>
    <?php /* "box-title" reuses the theme style of "Contact Information" (same spacing and font). */ ?>
    <strong class="box-title delgraf-customer-attributes__title">
        <span><?= $escaper->escapeHtml(__($title)) ?></span>
    </strong>
    <?php endif; ?>
    <dl class="delgraf-customer-attributes__list">
        <?php foreach ($viewModel->getRows() as $row): ?>
            <div class="delgraf-customer-attributes__item delgraf-customer-attributes__item--<?= $escaper->escapeHtmlAttr($row->getCode()) ?>">
                <dt class="delgraf-customer-attributes__label"><?= $escaper->escapeHtml($row->getLabel()) ?>:</dt>
                <dd class="delgraf-customer-attributes__value">
                    <?php if ($row->isLink()): ?>
                        <a href="<?= $escaper->escapeUrl($row->getUrl()) ?>"><?= $escaper->escapeHtml(__('Download')) ?></a>
                    <?php elseif ($row->isMultiline()): ?>
                        <?= nl2br($escaper->escapeHtml($row->getValue())) ?>
                    <?php else: ?>
                        <?= $escaper->escapeHtml($row->getValue()) ?>
                    <?php endif; ?>
                </dd>
            </div>
        <?php endforeach; ?>
    </dl>
</div>
